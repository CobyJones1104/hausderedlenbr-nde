---
/** Full-bleed hero photo — Andi bzw. Peter Piesch bei der Verkostung. */
---

<section class="hero">
  <div class="hero__media media">
    <img
      src="/images/hero-verkostung.jpg"
      alt="Verkostung eines Edelbrands im Glas, Haus der edlen Brände"
      width="1200"
      height="675"
      loading="eager"
      decoding="async"
    />
  </div>
  <div class="hero__content container">
    <h1 data-reveal>Tradition,<br />die man <em>schmeckt.</em></h1>
    <a class="hero__link" href="#sortiment" data-reveal style="--reveal-delay: 120ms">
      Unser Sortiment entdecken
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: min(92vh, 900px);
    min-height: 520px;
    display: flex;
    align-items: flex-end;
    color: #fff;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero__media::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.05) 45%, transparent 70%);
  }
  .hero__content {
    position: relative;
    z-index: 1;
    padding-block-end: var(--space-xl);
  }
  .hero h1 {
    font-size: var(--fs-hero);
    line-height: var(--lh-display-tight);
    color: #fff;
    max-width: 16ch;
  }
  .hero h1 em {
    font-style: normal;
    color: var(--color-copper-300);
  }
  .hero__link {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    margin-top: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .hero__link svg { width: 1.1em; height: 1.1em; transition: transform var(--motion-fast) var(--ease-standard); }
  .hero__link:hover svg { transform: translateX(4px); }
</style>
